# Copy to .env (never commit .env) or export these in your shell / scheduler.
DSE_SQL_SERVER=192.168.2.250
DSE_SQL_DATABASE=STT_ATS_MICS
DSE_SQL_DRIVER=ODBC Driver 18 for SQL Server
# Leave user/password empty to use Windows (trusted) authentication.
DSE_SQL_USER=report_reader
DSE_SQL_PASSWORD=change-me
DSE_EQUITY_API=https://dse.co.tz/api/get/market/prices/for/range/duration?class=EQUITY&security_code=ALL&days=2790
DSE_ETF_API=https://dse.co.tz/api/get/market/prices/for/range/duration?class=ETF&security_code=ALL&days=1470
DSE_INDEX_API=http://192.168.2.12:8086/api/index-data?startDate=2016-01-01&endDate=2026-12-31
# Instrument types treated as block-eligible and the deal Origin flag for negotiated/block deals
DSE_INSTRUMENT_TYPES=55
DSE_BLOCK_ORIGIN=P
DSE_BLOCK_START=2020-01-01
# Headline index used for market context (matched case-insensitively against index names)
DSE_HEADLINE_INDEX=DSEI
# True if the market-turnover figures from the price API already include block deals
DSE_TURNOVER_INCLUDES_BLOCKS=true
